# Copy this file to .env and fill in if you want LLM-enhanced classification,
# reply drafting, and LLM-as-judge scoring. The pipeline runs fully WITHOUT
# an API key too — it falls back to TF-IDF classification, retrieval-template
# reply drafting, and a heuristic judge. See README "Two modes" section.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
